{
  "name": "@olton/guardian",
  "version": "0.6.0",
  "main": "dist/guardian.js",
  "type": "module",
  "scripts": {
    "prebuild": "shx rm -rf dist/* lib/*",
    "build": "cross-env MODE=production node build.js",
    "dev": "cross-env MODE=development node build.js",
    "watch": "cross-env MODE=development node watch.js",
    "test": "easytest --verbose",
    "pub": "npm publish --access public"
  },
  "exports": {
    "import": "./dist/guardian.mjs",
    "require": "./dist/guardian.cjs"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "guard",
    "validating",
    "validate",
    "javascript"
  ],
  "author": "Serhii Pimenov <serhii@pimenov.com.ua>",
  "license": "MIT",
  "description": "Data validator",
  "devDependencies": {
    "@olton/easytest": "^0.39.0",
    "@olton/esbuild-plugin-progress": "^0.3.0",
    "esbuild-plugin-replace": "^1.4.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.0",
    "shx": "^0.3.4"
  }
}
